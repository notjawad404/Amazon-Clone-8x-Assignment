NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas: Database > Connect > Drivers. Keep /amazon-clone as the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/amazon-clone?retryWrites=true&w=majority

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe dashboard (test mode): Developers > API keys
STRIPE_SECRET_KEY=sk_test_
# From the Stripe CLI: stripe listen --print-secret (needed from Phase 9)
STRIPE_WEBHOOK_SECRET=

# Cloudinary console: Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
