# Stripe dashboard (test mode): Developers > API keys > Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
# Same cloud name as CLOUDINARY_CLOUD_NAME in server/.env
VITE_CLOUDINARY_CLOUD_NAME=

# Optional, dev server only (never sent to the browser). By default /api is proxied to
# http://localhost:<PORT from server/.env>. Set this only to point somewhere else.
# API_PROXY_TARGET=http://localhost:5000
